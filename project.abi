custom_code","id":"hsm~Y0XD~DA8Jp$-8TSM","fields":{"CODE":"  u8g2Fonts.setCursor(92, 270);"},"next":{"block":{"type":"custom_code","id":"hszGTy3uWIyEX2r[cn%f","fields":{"CODE":"  u8g2Fonts.print(\"[短按拍照键关闭热点]\");"},"next":{"block":{"type":"custom_code","id":"hs|S5ykR[l@{pXH+B@]y","fields":{"CODE":"} while (display.nextPage());"}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}},{"type":"custom_insert_code","id":"varR#5vKX(2NZL7r5Pqh[","x":30,"y":5030,"fields":{"POSITION":"variable","CODE":"WebServer server(80); DNSServer dnsServer;"}},{"type":"custom_insert_code","id":"var(ahdB^Z!BC3(_n9OE1","x":30,"y":5130,"fields":{"POSITION":"variable","CODE":"bool hotspotActive = false;"}},{"type":"custom_library","id":"lib~6J2Nd4Mz$JC+r@MV7","x":30,"y":4930,"fields":{"LIB_NAME":"WiFi.h"}},{"type":"custom_library","id":"libp8TPUpM}RrF*2Pg+hA","x":30,"y":5030,"fields":{"LIB_NAME":"WebServer.h"}},{"type":"custom_library","id":"glK}$Cgk/`:_dST1S^=`","x":30,"y":4730,"fields":{"LIB_NAME":"DNSServer.h"}},{"type":"custom_function","id":"lQXHz/tAu(Rd}j)puHQf","x":30,"y":15130,"fields":{"NAME":"showLastPhoto","RETURN":"void","PARAMS":""},"inputs":{"BODY":{"block":{"type":"custom_code","id":"showPhoto1","fields":{"CODE":"File f = LittleFS.open(\"/photos/current.jpg\", FILE_READ); if (!f) { Serial.println(\"[PHOTO] No current.jpg\"); showReadyScreen(); return; }"},"next":{"block":{"type":"custom_code","id":"showPhoto2","fields":{"CODE":"size_t sz = f.size(); if (sz == 0) { f.close(); showReadyScreen(); return; }"},"next":{"block":{"type":"custom_code","id":"showPhoto3","fields":{"CODE":"uint8_t* buf = (uint8_t*)ps_malloc(sz); if (!buf) { f.close(); Serial.println(\"[PHOTO] No psram\"); showReadyScreen(); return; } f.read(buf, sz); f.close();"},"next":{"block":{"type":"custom_code","id":"showPhoto4","fields":{"CODE":"const int dW = 128, dH = 296; int N = dW * dH; int camW = 320, camH = 240;"},"next":{"block":{"type":"custom_code","id":"showPhoto5","fields":{"CODE":"uint8_t* rgb888 = (uint8_t*)ps_malloc((size_t)camW * camH * 3); if (!rgb888) { free(buf); Serial.println(\"[PHOTO] No rgb mem\"); showReadyScreen(); return; }"},"next":{"block":{"type":"custom_code","id":"showPhoto6","fields":{"CODE":"if (!fmt2rgb888(buf, sz, PIXFORMAT_JPEG, rgb888)) { free(rgb888); free(buf); Serial.println(\"[PHOTO] Decode fail\"); showReadyScreen(); return; }"},"next":{"block":{"type":"custom_code","id":"showPhoto7","fields":{"CODE":"int16_t* eR = (int16_t*)ps_malloc(N * 2); int16_t* eG = (int16_t*)ps_malloc(N * 2); int16_t* eB = (int16_t*)ps_malloc(N * 2);"},"next":{"block":{"type":"custom_code","id":"showPhoto8","fields":{"CODE":"if (!eR || !eG || !eB) { free(eR); free(eG); free(eB); free(rgb888); free(buf); showReadyScreen(); return; }"},"next":{"block":{"type":"custom_code","id":"showPhoto9","fields":{"CODE":"memset(eR, 0, N * 2); memset(eG, 0, N * 2); memset(eB, 0, N * 2);"},"next":{"block":{"type":"custom_code","id":"showPhoto10","fields":{"CODE":"float scale = (float)dH / camW; int cropY0 = (camH - (int)(dW / scale + 0.5f)) / 2; memset(displayBuffer, 1, N);"},"next":{"block":{"type":"custom_code","id":"showPhoto11","fields":{"CODE":"Serial.println(\"[PHOTO] Dithering...\");"},"next":{"block":{"type":"custom_code","id":"showPhoto12","fields":{"CODE":"for (int dy = 0; dy < dH; dy++) { for (int dx = 0; dx < dW; dx++) { int idx = dy * dW + dx;"},"next":{"block":{"type":"custom_code","id":"showPhoto13","fields":{"CODE":"float fx = (float)dy / scale; float fy = (float)cropY0 + (float)dx / scale; fx = constrain(fx, 0.0f, (float)(camW - 1)); fy = constrain(fy, 0.0f, (float)(camH - 1));"},"next":{"block":{"type":"custom_code","id":"showPhoto14","fields":{"CODE":"int x0 = (int)fx, y0 = (int)fy; int x1 = (x0 < camW - 1) ? x0 + 1 : x0; int y1 = (y0 < camH - 1) ? y0 + 1 : y0; float tx = fx - x0, ty = fy - y0;"},"next":{"block":{"type":"custom_code","id":"showPhoto15","fields":{"CODE":"int i00 = (y0 * camW + x0) * 3; int i01 = (y0 * camW + x1) * 3; int i10 = (y1 * camW + x0) * 3; int i11 = (y1 * camW + x1) * 3;"},"next":{"block":{"type":"custom_code","id":"showPhoto16","fields":{"CODE":"float w00 = (1-tx)*(1-ty), w01 = tx*(1-ty), w10 = (1-tx)*ty, w11 = tx*ty;"},"next":{"block":{"type":"custom_code","id":"showPhoto17","fields":{"CODE":"int r = (int)(w00*rgb888[i00] + w01*rgb888[i01] + w10*rgb888[i10] + w11*rgb888[i11]); int g = (int)(w00*rgb888[i00+1] + w01*rgb888[i01+1] + w10*rgb888[i10+1] + w11*rgb888[i11+1]); int b = (int)(w00*rgb888[i00+2] + w01*rgb888[i01+2] + w10*rgb888[i10+2] + w11*rgb888[i11+2]);"},"next":{"block":{"type":"custom_code","id":"showPhoto18","fields":{"CODE":"r += eR[idx]; g += eG[idx]; b += eB[idx]; r = constrain(r, 0, 255); g = constrain(g, 0, 255); b = constrain(b, 0, 255);"},"next":{"block":{"type":"custom_code","id":"showPhoto19","fields":{"CODE":"bool isReddish = (r > g + 50) && (r > b + 50) && (r > 100); int dBl = r*r + g*g + b*b; int dWh = (r-255)*(r-255) + (g-255)*(g-255) + (b-255)*(b-255);"},"next":{"block":{"type":"custom_code","id":"showPhoto20","fields":{"CODE":"int qr, qg, qb; uint8_t qc; if (isReddish) { qc = 2; qr = 255; qg = 0; qb = 0; } else if (dBl <= dWh) { qc = 0; qr = 0; qg = 0; qb = 0; } else { qc = 1; qr = 255; qg = 255; qb = 255; } displayBuffer[idx] = qc;"},"next":{"block":{"type":"custom_code","id":"showPhoto21","fields":{"CODE":"int er = r - qr, eg = g - qg, eb = b - qb; if (dx + 1 < dW) { eR[idx+1] += er * 7 / 16; eG[idx+1] += eg * 7 / 16; eB[idx+1] += eb * 7 / 16; } if (dy + 1 < dH) { if (dx > 0) { eR[idx+dW-1] += er * 3 / 16; eG[idx+dW-1] += eg * 3 / 16; eB[idx+dW-1] += eb * 3 / 16; } eR[idx+dW] += er * 5 / 16; eG[idx+dW] += eg * 5 / 16; eB[idx+dW] += eb * 5 / 16; if (dx + 1 < dW) { eR[idx+dW+1] += er / 16; eG[idx+dW+1] += eg / 16; eB[idx+dW+1] += eb / 16; } }"},"next":{"block":{"type":"custom_code","id":"showPhoto22","fields":{"CODE":"} }"},"next":{"block":{"type":"custom_code","id":"showPhoto23","fields":{"CODE":"free(rgb888);"},"next":{"block":{"type":"custom_code","id":"showPhotoQuote","fields":{"CODE":"currentQuote = QUOTES[random(0, sizeof(QUOTES) / sizeof(QUOTES[0]))];"},"next":{"block":{"type":"custom_code","id":"showPhoto24","fields":{"CODE":"display.setFullWindow(); display.firstPage();"},"next":{"block":{"type":"custom_code","id":"showPhoto25","fields":{"CODE":"do { for (int y = 0; y < dH; y++) for (int x = 0; x < dW; x++) { uint8_t c = displayBuffer[y * dW + x]; display.drawPixel(dW - 1 - x, dH - 1 - y, c == 0 ? GxEPD_BLACK : (c == 2 ? GxEPD_RED : GxEPD_WHITE)); } u8g2Fonts.setFont(u8g2_font_wqy12_t_gb2312a); u8g2Fonts.setForegroundColor(GxEPD_BLACK); u8g2Fonts.setBackgroundColor(GxEPD_WHITE); u8g2Fonts.setCursor(100, 88); u8g2Fonts.print(currentQuote); } while (display.nextPage());"},"next":{"block":{"type":"custom_code","id":"showPhoto26","fields":{"CODE":"free(eR); free(eG); free(eB); free(buf);"}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}]},"variables":[{"name":"display","id":"Y3?i$&=zkQerKzQo$miP"},{"name":"display","id":"baZTf)?qRIW++i8?zem?","type":"GxEPD2"}],"$ailyProjectData":{"schemaVersion":1,"mode":"external-only"}}