elds":{"CODE":"int camW = frm->getWidth(), camH = frm->getHeight();"},"next":{"block":{"type":"custom_code","id":"Z]#._r?%|OL0FDBiCFCi","fields":{"CODE":"const int dW = 128, dH = 296; int N = dW * dH;"},"next":{"block":{"type":"custom_code","id":"8yC/s:g98n`%=`(mt](+","fields":{"CODE":"Serial.printf(\"[IMG] JPEG %dx%d (%u bytes)\\n\", camW, camH, (unsigned)frm->size());"},"next":{"block":{"type":"custom_code","id":"!e6-%tRePTUMUJTN7tiW","fields":{"CODE":"jpegSize = frm->size();"},"next":{"block":{"type":"custom_code","id":"l&`PfgSj95t{V&R*ngb5","fields":{"CODE":"jpegData = (uint8_t*)ps_malloc(jpegSize);"},"next":{"block":{"type":"custom_code","id":"USEDo0AnJ[P|!c2IKtnu","fields":{"CODE":"if (jpegData) memcpy(jpegData, frm->data(), jpegSize);"},"next":{"block":{"type":"custom_code","id":"-d$xa5`=N)6+AD_A{KCl","fields":{"CODE":"uint8_t* rgb888 = (uint8_t*)ps_malloc((size_t)camW * camH * 3);"},"next":{"block":{"type":"custom_code","id":"Tvjs23Z!X|z6Yk}.i2@9","fields":{"CODE":"if (!rgb888) { Serial.println(\"[IMG] RGB888 alloc failed!\"); free(jpegData); jpegData=nullptr; jpegSize=0; return; }"},"next":{"block":{"type":"custom_code","id":"tEDxhh.ZfcvMSv$650Ui","fields":{"CODE":"if (!fmt2rgb888(frm->data(), frm->size(), PIXFORMAT_JPEG, rgb888)) { Serial.println(\"[IMG] JPEG decode failed!\"); free(rgb888); free(jpegData); jpegData=nullptr; jpegSize=0; return; }"},"next":{"block":{"type":"custom_code","id":"IN+IJ!c.yiyU{TxzDx4_","fields":{"CODE":"int16_t* eR = (int16_t*)ps_malloc(N * 2);"},"next":{"block":{"type":"custom_code","id":"/}3.aWh3X)D}?&Y3zyvq","fields":{"CODE":"int16_t* eG = (int16_t*)ps_malloc(N * 2);"},"next":{"block":{"type":"custom_code","id":"bp}YW;Idf!1vAS$mkB}#","fields":{"CODE":"int16_t* eB = (int16_t*)ps_malloc(N * 2);"},"next":{"block":{"type":"custom_code","id":"E:y1)|E1vN}.rx7tVZV4","fields":{"CODE":"if (!eR || !eG || !eB) { Serial.println(\"[IMG] PSRAM alloc failed!\"); free(eR); free(eG); free(eB); free(rgb888); free(jpegData); jpegData=nullptr; j